-- ================= FONCTIONS =================
local flyOn, speedOn, farmOn = false, false, false
local flySpeed, walkSpeed = 60, 50
local flyConn, bv

local function getChar()
	local char = player.Character
	return char, char and char:FindFirstChild("HumanoidRootPart"), char and char:FindFirstChildOfClass("Humanoid")
end

local function setFly(state)
	flyOn = state
	if flyConn then flyConn:Disconnect() flyConn = nil end
	if bv then bv:Destroy() bv = nil end
	local _, root, hum = getChar()
	if not (root and hum) then return end
	if state then
		hum.PlatformStand = true
		bv = Instance.new("BodyVelocity")
		bv.MaxForce = Vector3.new(1e5, 1e5, 1e5)
		bv.Velocity = Vector3.zero
		bv.Parent = root
		flyConn = RunService.RenderStepped:Connect(function()
			local cam = workspace.CurrentCamera
			local move = cam.CFrame:VectorToObjectSpace(hum.MoveDirection)
			local dir = cam.CFrame.RightVector * move.X + cam.CFrame.LookVector * -move.Z
			local up = 0
			if UserInputService:IsKeyDown(Enum.KeyCode.E) then up = 1 end
			if UserInputService:IsKeyDown(Enum.KeyCode.Q) then up = -1 end
			bv.Velocity = (dir + Vector3.new(0, up, 0)) * flySpeed
		end)
	else
		hum.PlatformStand = false
	end
end

local function applySpeed()
	local _, _, hum = getChar()
	if hum then hum.WalkSpeed = speedOn and walkSpeed or 16 end
end

-- Auto-farm : téléporte sur l'objet taggé "Collectible" le plus proche.
-- À adapter avec la vraie mécanique de ton jeu.
local function farmStep()
	local _, root = getChar()
	if not root then return end
	local best, bestDist = nil, math.huge
	for _, obj in ipairs(CollectionService:GetTagged("Collectible")) do
		local part = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart")
		if part then
			local d = (part.Position - root.Position).Magnitude
			if d < bestDist then best, bestDist = part, d end
		end
	end
	if best then root.CFrame = best.CFrame + Vector3.new(0, 3, 0) end
end

local function setFarm(state)
	farmOn = state
	if state then
		task.spawn(function()
			while farmOn do
				farmStep()
				task.wait(0.5)
			end
		end)
	end
end

-- ===== NOCLIP =====
local noclipConn
local function setNoclip(state)
	if noclipConn then noclipConn:Disconnect() noclipConn = nil end
	if state then
		noclipConn = RunService.Stepped:Connect(function()
			local char = player.Character
			if not char then return end
			for _, p in ipairs(char:GetDescendants()) do
				if p:IsA("BasePart") then p.CanCollide = false end
			end
		end)
	end
end

-- ===== AUTO-FARM MONSTRES =====
-- Réglages à adapter à ton jeu :
local MOB_FOLDER = nil     -- ex: "Mobs" si les monstres sont dans workspace.Mobs (nil = tout le workspace)
local ATTACK_REMOTE = nil  -- nom exact du RemoteEvent d'attaque (nil = détection auto d'un RemoteEvent dont le nom contient "attack" ou "attaque")
local MOB_RANGE = 500

local mobFarmOn = false

local function getMobs()
	local container = MOB_FOLDER and workspace:FindFirstChild(MOB_FOLDER) or workspace
	local list = {}
	for _, h in ipairs(container:GetDescendants()) do
		if h:IsA("Humanoid") and h.Health > 0 then
			local model = h.Parent
			local root = model:FindFirstChild("HumanoidRootPart")
			if root and not Players:GetPlayerFromCharacter(model) then
				table.insert(list, { model = model, hum = h, root = root })
			end
		end
	end
	return list
end

local attackRemote
local function findAttackRemote()
	if attackRemote and attackRemote.Parent then return attackRemote end
	local rs = game:GetService("ReplicatedStorage")
	if ATTACK_REMOTE then
		attackRemote = rs:FindFirstChild(ATTACK_REMOTE, true)
	else
		for _, o in ipairs(rs:GetDescendants()) do
			local n = o.Name:lower()
			if o:IsA("RemoteEvent") and (n:find("attack") or n:find("attaque")) then
				attackRemote = o
				break
			end
		end
	end
	return attackRemote
end

-- Ce que fait le "clic droit" : le jeu envoie probablement l'attaque au serveur via le RemoteEvent.
-- Si ton jeu attend des arguments (ex: la cible), modifie la ligne FireServer.
local function attack(mob)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hum then return end
	local remote = findAttackRemote()
	if remote then
		remote:FireServer()
		return
	end
	-- Sinon : arme équipée
	local tool = char:FindFirstChildOfClass("Tool")
	if not tool then
		tool = player.Backpack:FindFirstChildOfClass("Tool")
		if tool then hum:EquipTool(tool) end
	end
	if tool then tool:Activate() end
end

local function setMobFarm(state)
	mobFarmOn = state
	if not state then return end
	task.spawn(function()
		local mobs, lastScan = {}, 0
		while mobFarmOn do
			local _, root = getChar()
			if root then
				if os.clock() - lastScan > 1 then
					mobs, lastScan = getMobs(), os.clock()
				end
				local best, bestDist = nil, MOB_RANGE
				for _, m in ipairs(mobs) do
					if m.hum.Health > 0 and m.root.Parent then
						local d = (m.root.Position - root.Position).Magnitude
						if d < bestDist then best, bestDist = m, d end
					end
				end
				if best then
					local target = best.root.Position
					root.CFrame = CFrame.lookAt(target + Vector3.new(0, 0, 4), target)
					attack(best)
				end
			end
			task.wait(0.15)
		end
	end)
end

player.CharacterAdded:Connect(function()
	task.wait(0.5)
	if flyOn then setFly(true) end
	applySpeed()
end)

